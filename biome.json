{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "apps/*/src/**",
      "apps/*/test/**",
      "packages/*/src/**",
      "packages/*/test/**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noTemplateCurlyInString": "off",
        "noAssignInExpressions": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  },
  "css": {
    "linter": {
      "enabled": false
    }
  }
}