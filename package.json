{
  "name": "daggler",
  "version": "0.1.0",
  "private": true,
  "description": "Daggler — a self-hostable semantic IDE for GitHub Actions. Visualize, validate, secure, simulate, and prove workflows.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome lint --diagnostic-level=warn .",
    "cli": "pnpm --filter daggler-cli exec daggler",
    "web": "pnpm --filter @daggler/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "dompurify": ">=3.4.16",
      "esbuild": ">=0.28.1"
    }
  }
}
