# Daggler environment variables
# Copy this file to .env and fill in the values before starting the stack.
#
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# Connection string for the Postgres 18 database.
# When using docker-compose the host should be "postgres" (the service name).
# For a local dev database without Docker use localhost.
DATABASE_URL=postgres://daggler:daggler@localhost:5432/daggler

# ── Application ───────────────────────────────────────────────────────────────
# Secret used to sign sessions and encrypt sensitive data at rest.
# Generate a strong value with: openssl rand -hex 32
DAGGLER_SECRET_KEY=change-me

# ── GitHub App ────────────────────────────────────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new.
# Required for reading private repositories and receiving webhook events.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Secret configured in your GitHub App's webhook settings.
GITHUB_WEBHOOK_SECRET=

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers.
# Used to authenticate users via "Sign in with GitHub".
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Local server hardening ────────────────────────────────────────────────────
# The web server binds to 127.0.0.1 and rejects requests whose Host is not
# localhost/127.0.0.1/[::1]. Add extra hostnames (comma-separated) if you serve
# it behind a reverse proxy.
# DAGGLER_ALLOWED_HOSTS=daggler.example.com
# Pin the per-launch API token (>=16 chars); random per start when unset.
# DAGGLER_TOKEN=
# Opt-in to powerful run rungs (off by default):
# DAGGLER_ALLOW_LOCAL_RUN=1          # full local runs via act/Docker
# DAGGLER_ALLOW_GITHUB_DISPATCH=1    # workflow dispatch using the host's gh login
