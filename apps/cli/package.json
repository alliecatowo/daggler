{
  "name": "daggler-cli",
  "version": "0.1.0",
  "description": "The daggler CLI — run Daggler's static analysis and security policies over GitHub Actions workflows from the terminal.",
  "type": "module",
  "bin": {
    "daggler": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@daggler/validators": "workspace:*",
    "@daggler/workflow-ir": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
